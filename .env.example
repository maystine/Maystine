# --- Base de données (Postgres, ex. Neon via l'intégration Vercel) ---
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# --- Connexion Discord (Auth.js) ---
# Générer avec : npx auth secret
AUTH_SECRET=
# Application Discord : https://discord.com/developers/applications > OAuth2
# Redirect URI à déclarer : https://maystine.vercel.app/api/auth/callback/discord
# (et http://localhost:3000/api/auth/callback/discord en local)
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# Ton identifiant Discord (Paramètres > Avancés > Mode développeur, puis clic droit sur ton profil > Copier l'identifiant)
ADMIN_DISCORD_ID=

# --- Optionnel : ping sur un salon Discord privé à chaque nouvelle demande ---
COACHING_WEBHOOK_URL=
